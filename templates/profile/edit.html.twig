{% extends 'layout/app.html.twig' %}
{% block title %}Modifier le profil - Todo Liste Productive{% endblock %}

{% block main %}
<div class="max-w-md mx-auto px-safe-margin pt-lg pb-10">

    <div class="flex items-center gap-md mb-lg">
        <a href="{{ path('app_profile') }}" class="text-on-surface-variant hover:text-primary transition-colors">
            <span class="material-symbols-outlined">arrow_back</span>
        </a>
        <h2 class="text-display-title text-on-surface">Modifier le profil</h2>
    </div>

    {{ form_start(profileForm, {attr: {class: 'space-y-lg', novalidate: true}}) }}

        <div class="flex flex-col gap-base">
            {{ form_label(profileForm.firstName, null, {label_attr: {class: 'text-label-caps text-on-surface-variant'}}) }}
            {{ form_widget(profileForm.firstName, {attr: {class: 'w-full h-12 px-md rounded-lg border border-outline-variant bg-surface-container-low text-body-main focus:border-primary focus:ring-1 focus:ring-primary transition-colors'}}) }}
            {{ form_errors(profileForm.firstName) }}
        </div>

        <div class="flex flex-col gap-base">
            {{ form_label(profileForm.lastName, null, {label_attr: {class: 'text-label-caps text-on-surface-variant'}}) }}
            {{ form_widget(profileForm.lastName, {attr: {class: 'w-full h-12 px-md rounded-lg border border-outline-variant bg-surface-container-low text-body-main focus:border-primary focus:ring-1 focus:ring-primary transition-colors'}}) }}
            {{ form_errors(profileForm.lastName) }}
        </div>

        <div class="flex flex-col gap-base">
            {{ form_label(profileForm.profileType, null, {label_attr: {class: 'text-label-caps text-on-surface-variant'}}) }}
            {{ form_widget(profileForm.profileType, {attr: {class: 'w-full h-12 px-md rounded-lg border border-outline-variant bg-surface-container-low text-body-main focus:border-primary focus:ring-1 focus:ring-primary'}}) }}
            {{ form_errors(profileForm.profileType) }}
        </div>

        <button type="submit"
                class="w-full h-12 bg-primary text-on-primary rounded-xl text-subtitle flex items-center justify-center gap-xs shadow-sm hover:brightness-110 active:scale-[0.98] transition-all">
            <span class="material-symbols-outlined">save</span>
            Enregistrer
        </button>

    {{ form_end(profileForm) }}
</div>
{% endblock %}