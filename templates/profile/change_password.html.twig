{% extends 'layout/app.html.twig' %}
{% block title %}Changer le mot de passe - Todo Liste Productive{% endblock %}

{% block main %}
<div class="max-w-md mx-auto px-safe-margin pt-lg pb-10">

    <div class="flex items-center gap-md mb-lg">
        <a href="{{ path('app_profile') }}" class="text-on-surface-variant hover:text-primary transition-colors">
            <span class="material-symbols-outlined">arrow_back</span>
        </a>
        <h2 class="text-display-title text-on-surface">Changer le mot de passe</h2>
    </div>

    {{ form_start(changePasswordForm, {attr: {class: 'space-y-lg', novalidate: true}}) }}

        <div class="flex flex-col gap-base">
            {{ form_label(changePasswordForm.currentPassword, null, {label_attr: {class: 'text-label-caps text-on-surface-variant'}}) }}
            {{ form_widget(changePasswordForm.currentPassword, {attr: {class: 'w-full h-12 px-md rounded-lg border border-outline-variant bg-surface-container-low text-body-main focus:border-primary focus:ring-1 focus:ring-primary transition-colors', placeholder: '••••••••'}}) }}
            {{ form_errors(changePasswordForm.currentPassword) }}
        </div>

        <div class="flex flex-col gap-base">
            {{ form_label(changePasswordForm.newPassword, null, {label_attr: {class: 'text-label-caps text-on-surface-variant'}}) }}
            {{ form_widget(changePasswordForm.newPassword, {attr: {class: 'w-full h-12 px-md rounded-lg border border-outline-variant bg-surface-container-low text-body-main focus:border-primary focus:ring-1 focus:ring-primary transition-colors', placeholder: '••••••••'}}) }}
            {{ form_errors(changePasswordForm.newPassword) }}
        </div>

        <div class="flex flex-col gap-base">
            {{ form_label(changePasswordForm.confirmPassword, null, {label_attr: {class: 'text-label-caps text-on-surface-variant'}}) }}
            {{ form_widget(changePasswordForm.confirmPassword, {attr: {class: 'w-full h-12 px-md rounded-lg border border-outline-variant bg-surface-container-low text-body-main focus:border-primary focus:ring-1 focus:ring-primary transition-colors', placeholder: '••••••••'}}) }}
            {{ form_errors(changePasswordForm.confirmPassword) }}
        </div>

        <div class="bg-surface-container-low p-md rounded-xl border border-outline-variant">
            <p class="text-helper-text text-on-surface-variant">
                <span class="material-symbols-outlined text-primary" style="font-size:14px">info</span>
                Le mot de passe doit contenir au moins 8 caractères.
            </p>
        </div>

        <button type="submit"
                class="w-full h-12 bg-primary text-on-primary rounded-xl text-subtitle flex items-center justify-center gap-xs shadow-sm hover:brightness-110 active:scale-[0.98] transition-all">
            <span class="material-symbols-outlined">lock_reset</span>
            Changer le mot de passe
        </button>

    {{ form_end(changePasswordForm) }}
</div>
{% endblock %}