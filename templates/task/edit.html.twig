{% extends 'layout/app.html.twig' %}
{% block title %}Modifier - {{ task.title }}{% endblock %}

{% block main %}
<div class="max-w-md mx-auto px-safe-margin pt-lg pb-10">

    <div class="flex items-center gap-md mb-lg">
        <a href="{{ path('app_task_show', {id: task.id}) }}" class="text-on-surface-variant hover:text-primary transition-colors">
            <span class="material-symbols-outlined">arrow_back</span>
        </a>
        <h2 class="text-display-title text-on-surface">Modifier la tâche</h2>
    </div>

    {{ form_start(taskForm, {attr: {class: 'space-y-lg', novalidate: true}}) }}

        <div class="flex flex-col gap-base">
            {{ form_label(taskForm.title, null, {label_attr: {class: 'text-label-caps text-on-surface-variant'}}) }}
            {{ form_widget(taskForm.title, {attr: {class: 'w-full h-12 px-md rounded-lg border border-outline-variant bg-surface-container-low text-body-main focus:border-primary focus:ring-1 focus:ring-primary transition-colors'}}) }}
            {{ form_errors(taskForm.title) }}
        </div>

        <div class="flex flex-col gap-base">
            {{ form_label(taskForm.description, null, {label_attr: {class: 'text-label-caps text-on-surface-variant'}}) }}
            {{ form_widget(taskForm.description, {attr: {class: 'w-full px-md py-sm rounded-lg border border-outline-variant bg-surface-container-low text-body-main focus:border-primary focus:ring-1 focus:ring-primary transition-colors resize-none'}}) }}
        </div>

        <div class="grid grid-cols-2 gap-sm">
            <div class="flex flex-col gap-base">
                {{ form_label(taskForm.priority, null, {label_attr: {class: 'text-label-caps text-on-surface-variant'}}) }}
                {{ form_widget(taskForm.priority, {attr: {class: 'w-full h-12 px-md rounded-lg border border-outline-variant bg-surface-container-low text-body-main focus:border-primary'}}) }}
            </div>
            <div class="flex flex-col gap-base">
                {{ form_label(taskForm.status, null, {label_attr: {class: 'text-label-caps text-on-surface-variant'}}) }}
                {{ form_widget(taskForm.status, {attr: {class: 'w-full h-12 px-md rounded-lg border border-outline-variant bg-surface-container-low text-body-main focus:border-primary'}}) }}
            </div>
        </div>

        <div class="flex flex-col gap-base">
            {{ form_label(taskForm.dueDate, null, {label_attr: {class: 'text-label-caps text-on-surface-variant'}}) }}
            {{ form_widget(taskForm.dueDate, {attr: {class: 'w-full h-12 px-md rounded-lg border border-outline-variant bg-surface-container-low text-body-main focus:border-primary'}}) }}
        </div>

        {# Pièces jointes existantes #}
        {% if task.attachments is not empty %}
            <div class="space-y-sm">
                <p class="text-label-caps text-on-surface-variant">PIÈCES JOINTES EXISTANTES</p>
                <div class="grid grid-cols-3 gap-sm">
                    {% for attachment in task.attachments %}
                        <div class="aspect-square rounded-lg overflow-hidden elevation-1 relative group">
                            <img src="{{ asset('uploads/attachments/' ~ attachment.filename) }}"
                                 alt="{{ attachment.originalName }}"
                                 class="w-full h-full object-cover">
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        <div class="flex flex-col gap-base">
            {{ form_label(taskForm.attachments, 'Ajouter des images', {label_attr: {class: 'text-label-caps text-on-surface-variant'}}) }}
            {{ form_widget(taskForm.attachments, {attr: {class: 'w-full text-body-main file:mr-md file:py-sm file:px-md file:rounded-full file:border-0 file:text-sm file:bg-primary file:text-on-primary hover:file:brightness-110'}}) }}
        </div>

        <button type="submit"
                class="w-full h-12 bg-primary text-on-primary rounded-xl text-subtitle flex items-center justify-center gap-xs shadow-sm hover:brightness-110 active:scale-[0.98] transition-all">
            <span class="material-symbols-outlined">save</span>
            Enregistrer les modifications
        </button>

    {{ form_end(taskForm) }}
</div>
{% endblock %}